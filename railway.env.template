# Railway Environment Variables Template
# Copy these to your Railway project's Variables section

# === REQUIRED ===
NODE_ENV=production
PORT=3000
DATABASE_URL=<Get this from Railway MySQL service>

# === JWT SECRET (Generate a random 32+ character string) ===
JWT_SECRET=<generate-random-32-char-string>

# === MANUS OAUTH (Get from Manus project settings) ===
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://oauth.manus.im
VITE_APP_ID=<your-manus-app-id>
OWNER_OPEN_ID=<your-owner-open-id>
OWNER_NAME=Robert Washburn

# === APP BRANDING ===
VITE_APP_TITLE=HVAC Troubleshoot Pro
VITE_APP_LOGO=<your-logo-url>

# === MANUS BUILT-IN APIs (Optional - if using Manus services) ===
BUILT_IN_FORGE_API_URL=https://api.manus.im
BUILT_IN_FORGE_API_KEY=<your-manus-api-key>
VITE_FRONTEND_FORGE_API_KEY=<your-frontend-api-key>

# === ANALYTICS (Optional) ===
VITE_ANALYTICS_ENDPOINT=<your-analytics-endpoint>
VITE_ANALYTICS_WEBSITE_ID=<your-website-id>

# === NOTES ===
# 1. DATABASE_URL will be automatically provided by Railway MySQL service
# 2. Generate JWT_SECRET using: openssl rand -base64 32
# 3. Get Manus OAuth values from your Manus project settings
# 4. After deployment, update OAuth callback URL to: https://your-app.railway.app/api/oauth/callback
